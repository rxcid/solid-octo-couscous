{
  "name": "music-sample-graph",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend",
    "lint": "npm run lint -w frontend",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:studio": "npm run db:studio -w backend",
    "import:sinc": "npm run import:sinc -w backend --",
    "openapi": "npm run openapi -w backend",
    "openapi:fixtures": "npm run openapi:fixtures -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
