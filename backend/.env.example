# Copy to backend/.env. Credentials match the defaults in ../docker-compose.yml.
DATABASE_URL=postgres://msg:msg@127.0.0.1:5432/music_sample_graph

HOST=localhost
PORT=4000

# Origin of the Next.js dev server, allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Sinc catalog for `npm run import:sinc`. Defaults to the Sinc checkout next to
# this repository (../Sincapp/Sinc/Resources/samples.sqlite).
# SINC_CATALOG=/path/to/samples.sqlite
