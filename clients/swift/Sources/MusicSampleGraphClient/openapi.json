{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Sample Graph API",
    "version": "1.0.0",
    "description": "Sinc's Music DNA graph: what a song samples, what samples it, and who else built on the same sources. Ids are Sinc's catalog canonical ids."
  },
  "components": {
    "schemas": {
      "ArtistCredit": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "creditedName": {
            "type": "string"
          },
          "joinPhrase": {
            "type": "string"
          }
        },
        "title": "ArtistCredit"
      },
      "Contributor": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "artistId": {
            "type": "string"
          },
          "creditedName": {
            "type": "string"
          }
        },
        "title": "Contributor"
      },
      "Direction": {
        "enum": [
          "sources",
          "derivatives"
        ],
        "title": "Direction",
        "type": "string"
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "title": "Error"
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "title": "ErrorDetail"
      },
      "Generation": {
        "type": "object",
        "required": [
          "role",
          "offset",
          "records"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/GenerationRole"
          },
          "offset": {
            "type": "integer"
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GenerationsRecord"
            }
          },
          "gapFromPrevious": {
            "$ref": "#/components/schemas/GenerationsGap"
          }
        },
        "title": "Generation"
      },
      "GenerationRole": {
        "enum": [
          "before",
          "thisSong",
          "sameGeneration",
          "after"
        ],
        "title": "GenerationRole",
        "type": "string"
      },
      "GenerationsFamily": {
        "type": "object",
        "required": [
          "root",
          "generations",
          "hasMoreBefore",
          "hasMoreAfter"
        ],
        "properties": {
          "root": {
            "$ref": "#/components/schemas/GenerationsRecord"
          },
          "generations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Generation"
            }
          },
          "hasMoreBefore": {
            "type": "boolean"
          },
          "hasMoreAfter": {
            "type": "boolean"
          }
        },
        "title": "GenerationsFamily"
      },
      "GenerationsGap": {
        "type": "object",
        "required": [
          "hasDateConflict"
        ],
        "properties": {
          "years": {
            "$ref": "#/components/schemas/GenerationsYearRange"
          },
          "hasDateConflict": {
            "type": "boolean"
          }
        },
        "title": "GenerationsGap"
      },
      "GenerationsRecord": {
        "type": "object",
        "required": [
          "id",
          "track",
          "handoffTypes",
          "connectedTitles",
          "alsoFromTitles"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "track": {
            "$ref": "#/components/schemas/GenerationsTrack"
          },
          "earliestYear": {
            "type": "integer"
          },
          "handoffTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HandoffType"
            }
          },
          "connectedTitles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alsoFromTitles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "title": "GenerationsRecord"
      },
      "GenerationsTrack": {
        "type": "object",
        "required": [
          "title",
          "artist",
          "kind",
          "catalogRecordingID"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/TrackKind"
          },
          "isrc": {
            "type": "string"
          },
          "musicBrainzRecordingID": {
            "type": "string"
          },
          "catalogRecordingID": {
            "type": "string",
            "pattern": "^node_[A-Za-z0-9_-]{1,100}$",
            "description": "A track's canonical id, as in Sinc's catalog, e.g. node_3577dce5b98f…."
          }
        },
        "title": "GenerationsTrack"
      },
      "GenerationsYearRange": {
        "type": "object",
        "required": [
          "lower",
          "upper"
        ],
        "properties": {
          "lower": {
            "type": "integer"
          },
          "upper": {
            "type": "integer"
          }
        },
        "title": "GenerationsYearRange"
      },
      "HandoffType": {
        "enum": [
          "sampled",
          "interpolated",
          "remixed"
        ],
        "title": "HandoffType",
        "type": "string"
      },
      "Identifier": {
        "type": "object",
        "required": [
          "namespace",
          "identifier"
        ],
        "properties": {
          "namespace": {
            "$ref": "#/components/schemas/IdentifierNamespace"
          },
          "identifier": {
            "type": "string"
          }
        },
        "title": "Identifier"
      },
      "IdentifierNamespace": {
        "enum": [
          "musicbrainz_recording",
          "isrc",
          "iswc",
          "apple_music",
          "spotify",
          "acrcloud",
          "audd",
          "acoustid"
        ],
        "title": "IdentifierNamespace",
        "type": "string"
      },
      "Lineage": {
        "type": "object",
        "required": [
          "direction",
          "truncated",
          "nodes"
        ],
        "properties": {
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "truncated": {
            "type": "boolean",
            "description": "The node budget cut the tree short."
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineageNode"
            },
            "description": "Depth-first: every node comes after its parent."
          }
        },
        "title": "Lineage"
      },
      "LineageClassification": {
        "enum": [
          "human",
          "ai_assisted",
          "ai_generated",
          "unknown"
        ],
        "title": "LineageClassification",
        "type": "string"
      },
      "LineageDisclosure": {
        "type": "object",
        "required": [
          "classification",
          "source"
        ],
        "properties": {
          "classification": {
            "$ref": "#/components/schemas/LineageClassification"
          },
          "source": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "evidenceText": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        },
        "title": "LineageDisclosure"
      },
      "LineageNode": {
        "type": "object",
        "required": [
          "id",
          "depth",
          "track",
          "hiddenChildCount",
          "isCycle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique in this response: \"0\" is the root, \"0.2\" its third child."
          },
          "parentId": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "description": "Generations from the root, which is 0."
          },
          "track": {
            "$ref": "#/components/schemas/TrackSummary"
          },
          "relationship": {
            "description": "The relationship joining this node to its parent.",
            "$ref": "#/components/schemas/Relationship"
          },
          "hiddenChildCount": {
            "type": "integer",
            "description": "Relationships this node has that the tree does not show."
          },
          "isCycle": {
            "type": "boolean",
            "description": "This song is already on the path to the root, so it is not expanded."
          }
        },
        "title": "LineageNode"
      },
      "MatchMethod": {
        "enum": [
          "canonical_id",
          "isrc",
          "mbid",
          "title_artist",
          "alias"
        ],
        "title": "MatchMethod",
        "type": "string"
      },
      "Provenance": {
        "type": "object",
        "required": [
          "sources",
          "sourceKinds",
          "assertionCount",
          "isVerified",
          "isInference"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Who asserts this, e.g. \"musicbrainz\", \"wikipedia\"."
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assertionCount": {
            "type": "integer"
          },
          "isVerified": {
            "type": "boolean",
            "description": "At least one assertion has been verified."
          },
          "isInference": {
            "type": "boolean",
            "description": "Inferred from shared writer credits rather than stated."
          },
          "confidence": {
            "type": "number",
            "description": "The highest confidence any source reports."
          },
          "evidenceExcerpt": {
            "type": "string"
          },
          "evidenceUrl": {
            "type": "string"
          }
        },
        "title": "Provenance"
      },
      "Relationship": {
        "type": "object",
        "required": [
          "id",
          "relationshipType",
          "source",
          "destination",
          "segments",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The relationship's canonical id (edge_…)."
          },
          "relationshipType": {
            "$ref": "#/components/schemas/RelationshipType"
          },
          "source": {
            "$ref": "#/components/schemas/TrackSummary"
          },
          "destination": {
            "$ref": "#/components/schemas/TrackSummary"
          },
          "notes": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Segment"
            }
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "title": "Relationship"
      },
      "RelationshipPage": {
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "description": "Related songs in all, before the limit."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Relationship"
            }
          }
        },
        "title": "RelationshipPage"
      },
      "Relationships": {
        "type": "object",
        "required": [
          "sources",
          "derivatives"
        ],
        "properties": {
          "sources": {
            "$ref": "#/components/schemas/RelationshipPage"
          },
          "derivatives": {
            "$ref": "#/components/schemas/RelationshipPage"
          }
        },
        "title": "Relationships",
        "description": "sources: what this song takes from (it is the destination). derivatives: what takes from this song (it is the source)."
      },
      "RelationshipType": {
        "enum": [
          "sampled",
          "interpolated",
          "covered",
          "remixed"
        ],
        "title": "RelationshipType",
        "type": "string"
      },
      "Resolution": {
        "type": "object",
        "required": [
          "tracks"
        ],
        "properties": {
          "matchedBy": {
            "$ref": "#/components/schemas/MatchMethod"
          },
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackSummary"
            },
            "description": "Every recording that matched. Empty when the catalog has none."
          }
        },
        "title": "Resolution"
      },
      "SampleType": {
        "enum": [
          "direct",
          "looped",
          "chopped",
          "pitch_shifted",
          "time_stretched",
          "filtered",
          "layered"
        ],
        "title": "SampleType",
        "type": "string"
      },
      "SearchResults": {
        "type": "object",
        "required": [
          "tracks"
        ],
        "properties": {
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackSummary"
            }
          }
        },
        "title": "SearchResults"
      },
      "Segment": {
        "type": "object",
        "required": [],
        "properties": {
          "element": {
            "type": "string",
            "description": "What was borrowed, e.g. \"drums (drum set)\"."
          },
          "atInSourceMs": {
            "type": "integer"
          },
          "atInDestinationMs": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer"
          },
          "sampleType": {
            "$ref": "#/components/schemas/SampleType"
          },
          "pitchShiftSemitones": {
            "type": "number"
          },
          "tempoRatio": {
            "type": "number"
          },
          "isReversed": {
            "type": "boolean"
          },
          "isLooped": {
            "type": "boolean"
          }
        },
        "title": "Segment"
      },
      "SiblingGroup": {
        "type": "object",
        "required": [
          "source",
          "total",
          "tracks"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/TrackSummary"
          },
          "total": {
            "type": "integer",
            "description": "Every other song built from this source."
          },
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackSummary"
            }
          }
        },
        "title": "SiblingGroup"
      },
      "Siblings": {
        "type": "object",
        "required": [
          "groups"
        ],
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SiblingGroup"
            }
          }
        },
        "title": "Siblings"
      },
      "TrackDetail": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "artistCredit",
          "identifiers",
          "artists",
          "contributors",
          "works",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^node_[A-Za-z0-9_-]{1,100}$",
            "description": "A track's canonical id, as in Sinc's catalog, e.g. node_3577dce5b98f…."
          },
          "kind": {
            "$ref": "#/components/schemas/TrackKind"
          },
          "title": {
            "type": "string"
          },
          "artistCredit": {
            "type": "string",
            "description": "The artist as credited on this recording."
          },
          "releaseYear": {
            "type": "integer"
          },
          "isrc": {
            "type": "string"
          },
          "musicbrainzRecordingId": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer"
          },
          "disambiguation": {
            "type": "string"
          },
          "identifiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          "artists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtistCredit"
            },
            "description": "The ordered artist credit. Joining creditedName (or name) and joinPhrase rebuilds artistCredit."
          },
          "contributors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contributor"
            }
          },
          "works": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Work"
            },
            "description": "Compositions this recording performs."
          },
          "lineageDisclosure": {
            "description": "Whether the recording is human-made or AI-generated. Null means not recorded, not human-made.",
            "$ref": "#/components/schemas/LineageDisclosure"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackSummary"
            },
            "description": "Other recordings of the same song: the same normalized title, artist, and kind, or a shared ISRC. Relationships and siblings cover all of them."
          }
        },
        "title": "TrackDetail"
      },
      "TrackKind": {
        "enum": [
          "song",
          "film",
          "tv",
          "comedy",
          "speech"
        ],
        "title": "TrackKind",
        "type": "string"
      },
      "TrackSummary": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "artistCredit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^node_[A-Za-z0-9_-]{1,100}$",
            "description": "A track's canonical id, as in Sinc's catalog, e.g. node_3577dce5b98f…."
          },
          "kind": {
            "$ref": "#/components/schemas/TrackKind"
          },
          "title": {
            "type": "string"
          },
          "artistCredit": {
            "type": "string",
            "description": "The artist as credited on this recording."
          },
          "releaseYear": {
            "type": "integer"
          },
          "isrc": {
            "type": "string"
          },
          "musicbrainzRecordingId": {
            "type": "string"
          }
        },
        "title": "TrackSummary"
      },
      "Work": {
        "type": "object",
        "required": [
          "id",
          "title",
          "iswcs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "iswcs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "title": "Work"
      }
    }
  },
  "paths": {
    "/v1/tracks/resolve": {
      "get": {
        "operationId": "resolveTrack",
        "summary": "Find the catalog recordings for a recognized song",
        "tags": [
          "tracks"
        ],
        "description": "Pass a catalog id, ISRC, MusicBrainz recording id, or title and artist. The first stages are Sinc's bundled lookup: canonical id, then the union of ISRC and MusicBrainz matches, then normalized title and artist. Known title and artist aliases are a last exact stage that only the online catalog has.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^node_[A-Za-z0-9_-]{1,100}$"
            },
            "in": "query",
            "name": "canonicalId",
            "required": false,
            "description": "A track's canonical id, as in Sinc's catalog, e.g. node_3577dce5b98f…."
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "in": "query",
            "name": "isrc",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "in": "query",
            "name": "mbid",
            "required": false,
            "description": "MusicBrainz recording id."
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 500
            },
            "in": "query",
            "name": "title",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 500
            },
            "in": "query",
            "name": "artist",
            "required": false
          },
          {
            "schema": {
              "$ref": "#/components/schemas/TrackKind"
            },
            "in": "query",
            "name": "kind",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resolution"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tracks/{id}": {
      "get": {
        "operationId": "getTrack",
        "summary": "A track, its credits, and its other versions",
        "tags": [
          "tracks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^node_[A-Za-z0-9_-]{1,100}$"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "A track's canonical id, as in Sinc's catalog, e.g. node_3577dce5b98f…."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackDetail"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tracks/{id}/relationships": {
      "get": {
        "operationId": "getRelationships",
        "summary": "What the song takes from, and what takes from it",
        "tags": [
          "tracks"
        ],
        "description": "Covers every version of the song. One relationship per related song, direction, and type, preferring the one that says what was borrowed. Only published relationships.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Per direction."
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^node_[A-Za-z0-9_-]{1,100}$"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "A track's canonical id, as in Sinc's catalog, e.g. node_3577dce5b98f…."
          }
        ],
        "responses": {
          "200": {
            "description": "sources: what this song takes from (it is the destination). derivatives: what takes from this song (it is the source).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Relationships"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tracks/{id}/lineage": {
      "get": {
        "operationId": "getLineage",
        "summary": "The song's lineage, generation by generation",
        "tags": [
          "tracks"
        ],
        "description": "A tree of relationships from the song outward, as Sinc's lineage view builds it: sources by default (what it samples, what those sample, and so on), or derivatives. Nodes come depth-first with parentId set, so a client can rebuild the tree in one pass.",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Direction"
            },
            "in": "query",
            "name": "direction",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 3
            },
            "in": "query",
            "name": "depth",
            "required": false,
            "description": "Generations below the root."
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "in": "query",
            "name": "rootLimit",
            "required": false,
            "description": "Children shown under the root."
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 4
            },
            "in": "query",
            "name": "childLimit",
            "required": false,
            "description": "Children shown under any other node."
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^node_[A-Za-z0-9_-]{1,100}$"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "A track's canonical id, as in Sinc's catalog, e.g. node_3577dce5b98f…."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lineage"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tracks/{id}/generations": {
      "get": {
        "operationId": "getGenerations",
        "summary": "The song's sound family, following sampled, interpolated and remixed handoffs",
